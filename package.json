{
  "name": "loyverse-google-sheets-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Back up Loyverse inventory, variants, and sales valuation to Google Sheets.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "sync": "tsx src/cli.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "coverage": "c8 --all --include=src/**/*.ts --exclude=src/cli.ts --exclude=src/server.ts --exclude=src/factory.ts --check-coverage --lines=90 --functions=90 --branches=90 --statements=90 npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "googleapis": "^159.0.0",
    "pino": "^9.9.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "c8": "^10.1.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}