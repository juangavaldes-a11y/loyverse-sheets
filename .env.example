PORT=3000
# On Render, set this to the exact HTTPS service URL without a trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# Use "personal" for one Loyverse account, or "oauth" for a distributable app.
LOYVERSE_AUTH_MODE=personal
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_CLIENT_ID=
LOYVERSE_CLIENT_SECRET=
LOYVERSE_SCOPES=ITEMS_READ INVENTORY_READ RECEIPTS_READ STORES_READ MERCHANT_READ

# Exactly 32 random bytes encoded as 64 hexadecimal characters.
TOKEN_ENCRYPTION_KEY=
# Protects POST /admin/sync and POST /admin/register-webhooks.
ADMIN_API_KEY=

GOOGLE_SPREADSHEET_ID=
# Complete one-line JSON for a service account that can edit the spreadsheet.
# Never commit the value or paste it into chat/logs.
GOOGLE_SERVICE_ACCOUNT_JSON=

POLL_INTERVAL_MINUTES=15
# Optional ISO-8601 lower bound for the first historical receipt import.
HISTORY_START_AT=2020-01-01T00:00:00.000Z